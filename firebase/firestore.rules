rules_version = '2';

// Everything requires a signed-in user. Accounts are created by hand in the
// Firebase console — there is no signup page — so "signed in" means Jacob or
// Christina and nobody else.
service cloud.firestore {
  match /databases/{database}/documents {

    match /photos/{photoId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.storagePath is string
                    && request.resource.data.scheduleItemId is string
                    && request.resource.data.caption is string
                    && request.resource.data.caption.size() < 500
                    // Uploads are stamped with the uploader's own identity so
                    // "who took this" can't be forged.
                    && request.resource.data.uploadedBy == request.auth.token.email;

      allow update, delete: if request.auth != null;
    }

    // Anything not matched above is denied by default.
  }
}
